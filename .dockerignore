venv
__pycache__
*.pyc
*.pyo

.git
.gitignore

.env
.env.local

tracking/ml/model.pkl
tracking/ml/demo_data.db

.pytest_cache
.mypy_cache
*.egg-info

node_modules
dist
build

.vscode
.idea
